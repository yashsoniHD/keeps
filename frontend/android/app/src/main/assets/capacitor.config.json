{
	"appId": "com.goheydigital.clipnote",
	"appName": "Clipnote",
	"webDir": "dist",
	"ios": {
		"backgroundColor": "#faf6ee",
		"contentInset": "automatic"
	},
	"android": {
		"backgroundColor": "#faf6ee"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"backgroundColor": "#faf6ee",
			"showSpinner": false
		},
		"Keyboard": {
			"resize": "native"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"FirebaseAuthentication": {
			"skipNativeAuth": true,
			"providers": [
				"apple.com",
				"google.com"
			]
		},
		"Preferences": {
			"group": "group.com.goheydigital.clipnote"
		}
	}
}
