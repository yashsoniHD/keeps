GOOGLE_CLOUD_PROJECT=weekly-updates-automation
GOOGLE_CLOUD_LOCATION=us-central1
# Gemini 3.x models are global-endpoint only
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
CLOUD_TASKS_QUEUE=keeps-jobs
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_WORKER_URL=https://keeps-api-XXXX.run.app
CLOUD_TASKS_SA_EMAIL=keeps-sa@weekly-updates-automation.iam.gserviceaccount.com
CLOUD_STORAGE_BUCKET=keeps-media-weekly-updates-automation
TEMP_DOWNLOAD_DIR=/tmp/keeps_downloads
ENABLE_IMAGEN=false
# Apify paid scraper — fallback when yt-dlp is IP-blocked from Cloud Run (Instagram/TikTok).
# Dormant unless APIFY_TOKEN is set; the free og-caption fallback covers the no-token case.
# APIFY_TOKEN=
# APIFY_INSTAGRAM_REEL_ACTOR=apify~instagram-reel-scraper
# APIFY_INSTAGRAM_POST_ACTOR=apify~instagram-post-scraper
# APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
# APIFY_DAILY_GLOBAL_CAP=200
# Firecrawl tier-2 fallback for bot-blocked product pages (not needed for amazon.in so far)
# FIRECRAWL_API_KEY=
# Watchlist mini-app: TMDB v4 Read Access Token (themoviedb.org → Settings → API → "API Read
# Access Token"). Empty = enrichment no-op (no posters/providers/details). Free for this use.
# TMDB_BEARER=
# DEFAULT_WATCH_REGION=IN
# Places mini-app: server-side calls use the runtime service account (ADC), like Vertex/Firestore
# — no API key. Just enable "Places API (New)" on the project. Set ENABLE_PLACES=false to turn the
# enrichment off (notes still save). The frontend Maps JS uses a SEPARATE browser key.
# ENABLE_PLACES=true
