rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profile: owner reads; the client may only write its own profile/prefs fields. Categories,
    // counters, plan etc. are backend-only (admin SDK bypasses rules).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
             .hasOnly(['display_name', 'email', 'photo_url', 'region', 'onboarding_done', 'signup_ref', 'signup_at', 'created_at']);
    }
    // Notes: owner reads/deletes; created and updated only by the backend.
    match /notes/{noteId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create, update: if false;
    }
    // Jobs: owner reads (live status via onSnapshot); written only by the backend.
    match /jobs/{jobId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow write: if false;
    }
    // Backend-only collections: PATs, rate-limit counters, global kill switch, TMDB cache,
    // acquisition (scrape metadata) cache.
    match /shortcut_tokens/{id} { allow read, write: if false; }
    match /usage/{id}           { allow read, write: if false; }
    match /system/{id}          { allow read, write: if false; }
    match /tmdb_cache/{id}      { allow read, write: if false; }
    match /acq_cache/{id}       { allow read, write: if false; }
  }
}
