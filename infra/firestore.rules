rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profile + categories: owner read/write (categories also written by backend admin SDK,
    // which bypasses rules).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Watchlist items (per-title, TMDB-enriched): owner reads live via onSnapshot.
    // Backend-write-only — the worker writes enrichment, and watched/rating go through the
    // /api/watch-items endpoints — so the client can never tamper with poster/provider data.
    match /users/{uid}/watch_items/{itemId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Wishlist items (per-product, fanned out from product notes): same shape as watch_items.
    // Owner reads live via onSnapshot; backend-write-only so the client can't tamper with the
    // worker-written price/image/buy-url fields — promote/purchase/target-price go through
    // /api/wish-items.
    match /users/{uid}/wish_items/{itemId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Places items (per-venue, fanned out from place notes, Google-Places-enriched): same shape.
    // Owner reads live via onSnapshot; backend-write-only so the client can't tamper with the
    // worker-written photo/rating/coords fields — promote/visit/rating/notes go through
    // /api/place-items. (places_cache, like tmdb_cache, is backend-only via default-deny.)
    match /users/{uid}/place_items/{itemId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Recipe items (per-recipe, fanned out from recipe notes; no external API — a pure copy of the
    // note's structured ingredients/steps): same shape. Owner reads live via onSnapshot;
    // backend-write-only so the client can't tamper with the worker-written fields — the favorite
    // toggle goes through /api/recipe-items.
    match /users/{uid}/recipe_items/{itemId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Trip items (per-trip, fanned out from itinerary notes; a near-pure copy of the note's
    // structured days/stops, with stops geocoded for the map): same shape. Owner reads live via
    // onSnapshot; backend-write-only so the client can't tamper with the worker-written fields —
    // the favorite toggle goes through /api/trip-items.
    match /users/{uid}/trip_items/{itemId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Notes: owner reads/deletes; anyone may read a note the owner has shared
    // (is_public == true) — that powers the public /p/{id} link. Created and updated
    // only by the backend (which toggles is_public via the admin SDK).
    match /notes/{noteId} {
      allow read: if resource.data.is_public == true
                  || (request.auth != null && request.auth.uid == resource.data.user_id);
      allow delete: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create, update: if false;
    }
    // Collections (user-created folders). Owner-only, and — unlike notes — written directly
    // by the client (they hold only the user's own organisation: name, style, and a note_ids[]
    // membership list, never note content). Mirrors the owner-writable users/{uid} doc.
    // create checks the INCOMING doc's user_id (no resource yet); other ops check the stored one.
    match /collections/{cid} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create:       if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow update:       if request.auth != null && request.auth.uid == resource.data.user_id
                          && request.resource.data.user_id == resource.data.user_id;
    }
    // Search index (one doc per note). Backend-write-only — the worker keeps it in sync
    // (upsert on create/edit, delete on delete). Owner reads live via onSnapshot to power the
    // "recent saves" strip; semantic search + Clip AI query it server-side.
    match /search_index/{entryId} {
      allow read:  if request.auth != null && request.auth.uid == resource.data.user_id;
      allow write: if false;
    }
    // Private per-note annotations (owner's "your thoughts"). Kept OUT of the note doc
    // so a publicly shared note never exposes them. Owner reads; backend admin SDK writes.
    match /annotations/{noteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow write: if false;
    }
    // Jobs: owner reads (live status via onSnapshot); written only by the backend.
    match /jobs/{jobId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow write: if false;
    }
    // Personal Access Tokens (iOS shortcut): backend only — never client-readable.
    match /shortcut_tokens/{tokenId} {
      allow read, write: if false;
    }
    // Rate-limit counters and global kill switch: backend only.
    match /usage/{docId} {
      allow read, write: if false;
    }
    match /system/{docId} {
      allow read, write: if false;
    }
  }
}
