{
  "displayName": "Clip Note: backend ERROR logs",
  "documentation": {
    "content": "clip-note-api emitted ERROR-severity logs (failed process jobs, unhandled exceptions, or client-reported errors). Check Cloud Logging: resource.labels.service_name=\"clip-note-api\" severity>=ERROR",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "ERROR log entries",
      "conditionMatchedLog": {
        "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"clip-note-api\" AND severity>=ERROR"
      }
    }
  ],
  "combiner": "OR",
  "alertStrategy": {
    "notificationRateLimit": { "period": "3600s" },
    "autoClose": "86400s"
  },
  "notificationChannels": ["projects/weekly-updates-automation/notificationChannels/7390982931227143432"]
}
