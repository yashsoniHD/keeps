{
  "displayName": "Clip Note: Cloud Tasks queue backing up",
  "documentation": {
    "content": "clip-note-jobs queue depth exceeded 100 for 10+ minutes — the worker is failing or can't keep up. Check Cloud Run logs and Cloud Tasks console.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "queue depth > 100",
      "conditionThreshold": {
        "filter": "resource.type=\"cloud_tasks_queue\" AND resource.labels.queue_id=\"clip-note-jobs\" AND metric.type=\"cloudtasks.googleapis.com/queue/depth\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 100,
        "duration": "600s",
        "aggregations": [{ "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_MEAN" }]
      }
    }
  ],
  "combiner": "OR",
  "alertStrategy": { "autoClose": "86400s" },
  "notificationChannels": ["projects/weekly-updates-automation/notificationChannels/7390982931227143432"]
}
