{
  "expo": {
    "name": "Clipnote",
    "slug": "clipnote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clipnote",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.goheydigital.clipnote",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:clipnote.web.app"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Clipnote uses the microphone to record voice notes you save.",
        "NSPhotoLibraryUsageDescription": "Clipnote needs access to your photos so you can save images as notes.",
        "NSCameraUsageDescription": "Clipnote uses the camera to capture photos you save as notes."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.goheydigital.clipnote"
        ]
      }
    },
    "android": {
      "package": "com.goheydigital.clipnote",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fdf8f0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withShareExtension",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
